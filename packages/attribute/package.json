{
	"name": "@pocket-forge/attribute",
	"version": "0.0.0",
	"description": "Reusable project-level attribute definitions and assignments for Pocket Forge.",
	"keywords": [
		"pocket-forge",
		"rpg",
		"game-development",
		"attribute",
		"definition",
		"assignment"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/pocket-forge.git",
		"directory": "packages/attribute"
	},
	"homepage": "https://github.com/MarioMH8/pocket-forge",
	"bugs": {
		"url": "https://github.com/MarioMH8/pocket-forge/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./domain": {
			"development": "./src/domain/index.ts",
			"types": "./dist/domain/index.d.mts",
			"default": "./dist/domain/index.mjs"
		},
		"./infrastructure": {
			"development": "./src/infrastructure/index.ts",
			"types": "./dist/infrastructure/index.d.mts",
			"default": "./dist/infrastructure/index.mjs"
		},
		"./mother/domain": {
			"development": "./mother/domain/index.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "tsdown"
	},
	"peerDependencies": {
		"@hexadrop/error": "^2.0.0",
		"@hexadrop/types": "^2.0.0",
		"zod": "^3.0.0"
	},
	"devDependencies": {
		"@faker-js/faker": "10.6.0",
		"@hexadrop/error": "2.0.0",
		"@hexadrop/types": "2.0.0",
		"tsdown": "0.23.0",
		"zod": "3.25.76"
	}
}
