{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/domain/index.ts"],
	"plugin": ["typedoc-plugin-markdown"],
	"readme": "none",
	"githubPages": false,
	"excludeExternals": true,
	"hideBreadcrumbs": true,
	"hidePageHeader": true,
	"hideGroupHeadings": true,
	"useCodeBlocks": true,
	"typeDeclarationVisibility": "compact",
	"entryFileName": "index",
	"membersWithOwnFile": [],
	"enumMembersFormat": "list",
	"parametersFormat": "list",
	"interfacePropertiesFormat": "list",
	"classPropertiesFormat": "list",
	"typeDeclarationFormat": "list",
	"indexFormat": "list",
	"externalSymbolLinkMappings": {
		"@hexadrop/value-object": {
			"UlidValueObject": "https://github.com/hexadrop/hexadrop"
		},
		"@hexadrop/either": {
			"Either": "https://github.com/hexadrop/hexadrop"
		},
		"@hexadrop/error": {
			"DomainError": "https://github.com/hexadrop/hexadrop"
		}
	}
}
