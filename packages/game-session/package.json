{
	"name": "@pocket-forge/game-session",
	"version": "0.0.0",
	"description": "Global state container for a Pocket Forge playthrough.",
	"keywords": [
		"pocket-forge",
		"rpg",
		"game-development",
		"simulation",
		"game-session",
		"command",
		"domain-event",
		"save",
		"replay",
		"game-engine"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marioMH8/pocket-forge.git",
		"directory": "packages/game-session"
	},
	"homepage": "https://github.com/marioMH8/pocket-forge",
	"bugs": {
		"url": "https://github.com/marioMH8/pocket-forge/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./domain": {
			"development": "./src/domain/index.ts",
			"types": "./dist/domain/index.d.mts",
			"default": "./dist/domain/index.mjs"
		},
		"./application": {
			"development": "./src/application/index.ts",
			"types": "./dist/application/index.d.mts",
			"default": "./dist/application/index.mjs"
		},
		"./mock/domain": {
			"development": "./mock/domain/index.ts"
		},
		"./mother/domain": {
			"development": "./mother/domain/index.ts"
		},
		"./mother/application": {
			"development": "./mother/application/index.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "tsdown"
	},
	"peerDependencies": {
		"@hexadrop/aggregate-root": "^2.0.2",
		"@hexadrop/command": "^2.1.0",
		"@hexadrop/either": "^2.0.1",
		"@hexadrop/error": "^2.0.0",
		"@hexadrop/event": "^2.1.0",
		"@hexadrop/ioc": "^2.0.0",
		"@hexadrop/query": "^2.1.0",
		"@hexadrop/types": "^2.0.0",
		"@hexadrop/value-object": "^2.0.1",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@faker-js/faker": "10.6.0",
		"@hexadrop/aggregate-root": "2.0.2",
		"@hexadrop/command": "2.1.0",
		"@hexadrop/either": "2.0.1",
		"@hexadrop/error": "2.0.0",
		"@hexadrop/event": "2.1.0",
		"@hexadrop/ioc": "2.0.0",
		"@hexadrop/query": "2.1.0",
		"@hexadrop/types": "2.0.0",
		"@hexadrop/value-object": "2.0.1",
		"tsdown": "0.23.0",
		"ulid": "3.0.2"
	}
}
