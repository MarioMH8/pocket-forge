{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"customConditions": ["development"],
		"paths": {
			"@pocket-forge/*/mock/application": [
				"./packages/*/mock/application/index.ts",
				"./plugins/*/mock/application/index.ts"
			],
			"@pocket-forge/*/mock/domain": ["./packages/*/mock/domain/index.ts", "./plugins/*/mock/domain/index.ts"],
			"@pocket-forge/*/mock/infrastructure": [
				"./packages/*/mock/infrastructure/index.ts",
				"./plugins/*/mock/infrastructure/index.ts"
			],
			"@pocket-forge/*/mother/application": [
				"./packages/*/mother/application/index.ts",
				"./plugins/*/mother/application/index.ts"
			],
			"@pocket-forge/*/mother/domain": [
				"./packages/*/mother/domain/index.ts",
				"./plugins/*/mother/domain/index.ts"
			],
			"@pocket-forge/*/application": [
				"./packages/*/src/application/index.ts",
				"./plugins/*/src/application/index.ts"
			],
			"@pocket-forge/*/catalog": [
				"./packages/*/src/catalog/index.ts",
				"./plugins/*/src/catalog/index.ts"
			],
			"@pocket-forge/*/domain": ["./packages/*/src/domain/index.ts", "./plugins/*/src/domain/index.ts"],
			"@pocket-forge/*/infrastructure": [
				"./packages/*/src/infrastructure/index.ts",
				"./plugins/*/src/infrastructure/index.ts"
			],
			"@pocket-forge/*/rules": ["./packages/*/src/rules/index.ts"],
			"@pocket-forge/*": ["./packages/*/src/index.ts", "./plugins/*/src/index.ts"]
		},
		"types": ["bun"]
	},
	"exclude": ["**/dist/**", "node_modules", "apps/docs"]
}
