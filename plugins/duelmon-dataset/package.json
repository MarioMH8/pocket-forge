{
	"name": "@pocket-forge/duelmon-dataset",
	"version": "0.0.0",
	"description": "Pokémon Showdown Gen 1 dataset extraction and normalization for Duelmon.",
	"keywords": [
		"pocket-forge",
		"rpg",
		"game-development",
		"duelmon",
		"pokemon",
		"dataset"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/pocket-forge.git",
		"directory": "plugins/duelmon-dataset"
	},
	"homepage": "https://github.com/MarioMH8/pocket-forge",
	"bugs": {
		"url": "https://github.com/MarioMH8/pocket-forge/issues"
	},
	"license": "MIT",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./mother/domain": {
			"development": "./mother/domain/index.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"extract": "bun run src/cli/index.ts extract"
	},
	"peerDependencies": {
		"@hexadrop/error": "^2.0.0"
	},
	"devDependencies": {
		"@hexadrop/error": "2.0.0",
		"commander": "15.1.0",
		"tsdown": "0.23.7",
		"zod": "4.6.7"
	}
}
