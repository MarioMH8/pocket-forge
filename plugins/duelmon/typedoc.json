{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/domain/index.ts"],
	"plugin": ["typedoc-plugin-markdown"],
	"readme": "none",
	"githubPages": false,
	"excludeExternals": true,
	"hideBreadcrumbs": true,
	"hidePageHeader": true,
	"hideGroupHeadings": true,
	"useCodeBlocks": true,
	"typeDeclarationVisibility": "compact",
	"entryFileName": "index",
	"membersWithOwnFile": [],
	"enumMembersFormat": "list",
	"parametersFormat": "list",
	"interfacePropertiesFormat": "list",
	"classPropertiesFormat": "list",
	"typeDeclarationFormat": "list",
	"indexFormat": "list",
	"externalSymbolLinkMappings": {
		"@pocket-forge/attribute": {
			"AttributeMap": "/api/attribute/",
			"AttributeValues": "/api/attribute/",
			"AttributeValue": "/api/attribute/",
			"default": "/api/attribute/"
		},
		"@pocket-forge/combat": {
			"Combat": "/api/combat/",
			"Combatant": "/api/combat/",
			"CombatantGroup": "/api/combat/",
			"CombatPrimitives": "/api/combat/",
			"CombatTransitionError": "/api/combat/",
			"default": "/api/combat/"
		},
		"@pocket-forge/combat-engine": {
			"CombatActionPlugin": "/api/combat-engine/",
			"CombatActionSet": "/api/combat-engine/",
			"CombatActionSet.create": "/api/combat-engine/",
			"CombatRuleset": "/api/combat-engine/",
			"CombatRulesetPrimitives": "/api/combat-engine/",
			"default": "/api/combat-engine/"
		},
		"@pocket-forge/creature": {
			"CreaturePrimitives": "/api/creature/"
		}
	}
}
