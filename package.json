{
	"name": "pocket-forge",
	"description": "Build your own RPG from map to battle to replay. No coding, no borrowed worlds, no limits.",
	"keywords": [
		"rpg",
		"game-engine",
		"creature-collection",
		"game-development",
		"toolkit",
		"map-editor",
		"battle-system",
		"turn-based",
		"game-authoring",
		"simulation"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com//pocket-forge.git"
	},
	"homepage": "https://github.com/MarioMH8/pocket-forge",
	"bugs": {
		"url": "https://github.com/MarioMH8/pocket-forge/issues"
	},
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"commitlint": "commitlint --edit",
		"lint": "eslint --cache",
		"lint:ci": "eslint --cache --cache-strategy content",
		"lint:fix": "eslint --cache --fix",
		"prepare": "husky",
		"test": "bun test --conditions=development",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@faker-js/faker": "10.6.0",
		"@hexadrop/eslint-config": "1.0.11",
		"@hexadrop/tsconfig": "0.0.5",
		"@types/bun": "1.4.2",
		"eslint": "10.10.0",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"reflect-metadata": "0.2.2",
		"typescript": "7.0.2"
	}
}
