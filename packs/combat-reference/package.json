{
	"name": "@pocket-forge/combat-reference",
	"version": "0.0.0",
	"description": "Reference Combat formats, action plugin, and authored action set for Pocket Forge. Proves format, move logic, and authored bindings live outside the neutral core.",
	"keywords": [
		"pocket-forge",
		"rpg",
		"game-development",
		"combat",
		"plugin",
		"reference"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/pocket-forge.git",
		"directory": "packs/combat-reference"
	},
	"homepage": "https://github.com/MarioMH8/pocket-forge",
	"bugs": {
		"url": "https://github.com/MarioMH8/pocket-forge/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"manifest.json"
	],
	"exports": {
		"./domain": {
			"development": "./src/domain/index.ts",
			"types": "./dist/domain/index.d.mts",
			"default": "./dist/domain/index.mjs"
		},
		"./manifest.json": "./manifest.json",
		"./pack": {
			"development": "./src/pack/index.ts",
			"types": "./dist/pack/index.d.mts",
			"default": "./dist/pack/index.mjs"
		},
		"./mother/domain": {
			"development": "./mother/domain/index.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"prepublishOnly": "tsdown"
	},
	"peerDependencies": {
		"@hexadrop/either": "^2.0.0",
		"@hexadrop/error": "^2.0.0",
		"@hexadrop/types": "^2.0.0",
		"@pocket-forge/attribute": "workspace:*",
		"@pocket-forge/combat": "workspace:*",
		"@pocket-forge/pack": "workspace:*",
		"semver": "^7.0.0"
	},
	"devDependencies": {
		"@faker-js/faker": "10.6.0",
		"@hexadrop/either": "2.0.1",
		"@hexadrop/error": "2.0.0",
		"@hexadrop/types": "2.0.0",
		"@pocket-forge/attribute": "0.0.0",
		"@pocket-forge/combat": "0.0.0",
		"@pocket-forge/pack": "0.0.0",
		"@types/semver": "7.8.0",
		"semver": "7.8.6",
		"tsdown": "0.23.7"
	}
}
